<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>go2_ros_gazebo</name>
  <version>0.0.0</version>
  <description>Simulación del cuadrúpedo Unitree Go2 en ROS 2 + Gazebo con control de locomoción mediante una política de aprendizaje por refuerzo (RL).</description>
  <maintainer email="127719599+louis9RM@users.noreply.github.com">Ever Ramos</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>urdf</depend>
  <depend>xacro</depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
